<div class="card overflow-x-auto">
  <table class="table-base table-stack" data-automation-table>
    <thead><tr><th>Name</th><th>Runs On</th><th>Schedule</th><th>Steps</th><th class="text-right">Next Run</th><th>Last Result</th><th>Enabled</th><th class="text-right"></th></tr></thead>
    <tbody>
      {{#each rows}}
        <tr data-automation-row data-automation-id="{{id}}" data-automation-name="{{name}}" data-automation-cron="{{cron}}" data-def="{{jsonAttr def}}">
          <td data-th="Name" class="font-medium">{{name}}</td>
          <td data-th="Runs On" class="text-ink-soft">{{runsOn}}</td>
          <td data-th="Schedule" class="font-mono text-xs text-ink-faint">{{cron}}</td>
          <td data-th="Steps" class="text-ink-soft">{{summary}}</td>
          <td data-th="Next Run" class="whitespace-nowrap text-right tabular-nums text-ink-faint">{{#if nextMs}}<span data-ts="{{nextMs}}">{{next}}</span>{{else}}Not scheduled{{/if}}</td>
          <td data-th="Last Result">
            {{#if lastStatus}}
              <button type="button" class="btn btn-ghost btn-sm" data-automation-runs data-tip="See the recent runs.">
                {{#if lastOk}}<span class="badge badge-ok">OK</span>{{/if}}
                {{#if lastPartial}}<span class="badge badge-warn">Partial</span>{{/if}}
                {{#if lastFailed}}<span class="badge badge-danger">Failed</span>{{/if}}
              </button>
            {{else}}
              <button type="button" class="btn btn-ghost btn-sm" data-automation-runs data-tip="See the recent runs.">
                <span class="text-ink-faint">Never Run</span>
              </button>
            {{/if}}
          </td>
          <td data-th="Enabled">
            <label class="msm-toggle"><input type="checkbox" data-automation-toggle aria-label="Enabled" {{#if enabled}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}><span></span></label>
          </td>
          <td data-th="" class="text-right">
            {{#if canEdit}}
              <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
                <button type="button" class="btn btn-ghost btn-sm" data-automation-run data-tip="Run this automation now." aria-label="Run {{name}} now">{{{icon 'play' 'size-3.5'}}}</button>
                <button type="button" class="btn btn-ghost btn-sm" data-automation-edit data-tip="Edit this automation." aria-label="Edit {{name}}">{{{icon 'pencil' 'size-3.5'}}}</button>
                <button type="button" class="btn btn-ghost btn-sm text-danger" data-automation-delete data-tip="Delete this automation." aria-label="Delete {{name}}">{{{icon 'trash-2' 'size-3.5'}}}</button>
              </div>
            {{/if}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
