{{! Bulk action bar for the file manager. Hidden until at least one row is
    selected; files.js shows it and fills the count. Fixed to the bottom of the
    viewport on phones, sticky above the table from sm up. }}
<div id="files-bulk-bar" hidden class="fixed inset-x-0 bottom-0 z-[25] flex flex-wrap items-center gap-2 border-t border-line bg-raised px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-overlay sm:sticky sm:inset-x-auto sm:top-14 sm:bottom-auto sm:border-b sm:border-t-0 sm:py-2" role="toolbar" aria-label="Actions for the selected items">
  <span class="mr-auto text-sm font-medium" id="files-bulk-count" aria-live="polite">0 selected</span>
  <button type="button" class="btn btn-sm btn-danger" data-bulk="delete">{{{icon 'trash-2' 'size-3.5'}}} Delete</button>
  <button type="button" class="btn btn-sm" data-bulk="move">{{{icon 'move' 'size-3.5'}}} Move To…</button>
  <button type="button" class="btn btn-sm" data-bulk="copy">{{{icon 'copy' 'size-3.5'}}} Copy To…</button>
  <button type="button" class="btn btn-sm" data-bulk="download">{{{icon 'download' 'size-3.5'}}} Download</button>
  {{#if customizations}}<button type="button" class="btn btn-sm" data-bulk="customize" data-tip="Keep these files across pack updates.">{{{icon 'save' 'size-3.5'}}} Add To Customizations</button>{{/if}}
  <button type="button" class="btn btn-sm btn-ghost" data-bulk="all">Select All</button>
  <button type="button" class="btn btn-sm btn-ghost" data-bulk="clear">Clear Selection</button>
</div>
{{! Phones: keeps the fixed bar from covering the last rows while it is shown. }}
<div id="files-bulk-spacer" hidden class="h-32 sm:h-0" aria-hidden="true"></div>
