{{#if notFound}}
  <div class="card w-full max-w-sm p-8 text-center">
    <div class="pixel text-4xl text-danger">404</div>
    <h1 class="mt-4 text-lg font-semibold">Status Page Not Found</h1>
    <p class="mt-1 text-sm text-ink-faint">This status page does not exist, or the server owner has turned it off.</p>
  </div>
{{else}}
  <div class="card w-full max-w-md overflow-hidden" style="border-top: 3px solid {{page.accent}}">
    <div class="texture-top p-6 text-center">
      <img src="{{iconSrc page.icon}}" alt="" class="mx-auto size-16 rounded-lg" style="background: {{page.accent}}" data-fallback-icon="/icons/servers/grass.svg">
      <h1 class="mt-3 text-xl font-bold">{{page.name}}</h1>
      {{#if page.motd}}<p class="mt-1 text-sm text-ink-soft">{{page.motd}}</p>{{/if}}
      <div class="mt-3 flex items-center justify-center gap-1.5 text-sm font-medium {{statusText page.status}}">
        <span class="status-dot relative {{statusDot page.status}} {{#if (statusPulse page.status)}}pulse{{/if}}"></span>
        {{statusLabel page.status}}
      </div>
    </div>
    {{#if page.address}}
      <div class="border-t border-line bg-raised p-3 text-center">
        <div class="eyebrow">Server Address</div>
        <div class="mt-1 flex flex-wrap items-center justify-center gap-2">
          <span class="select-all break-all font-mono text-sm font-semibold" id="status-address">{{page.address}}</span>
          <button class="btn btn-sm" data-copy-from="#status-address">{{{icon 'copy' 'size-3.5'}}} Copy</button>
        </div>
      </div>
    {{/if}}
    <dl class="grid grid-cols-3 gap-px border-t border-line bg-line text-center tabular-nums">
      <div class="bg-raised p-3">
        <dt class="eyebrow">Version</dt>
        <dd class="mt-0.5 text-sm font-semibold">{{page.flavor}} {{page.mcVersion}}</dd>
      </div>
      <div class="bg-raised p-3">
        <dt class="eyebrow">Players</dt>
        <dd class="mt-0.5 text-sm font-semibold">{{page.online}} / {{page.max}}</dd>
      </div>
      <div class="bg-raised p-3">
        <dt class="eyebrow">Uptime</dt>
        <dd class="mt-0.5 text-sm font-semibold">{{#if page.uptime}}{{page.uptime}}{{else}}Unknown{{/if}}</dd>
      </div>
    </dl>
    <p class="border-t border-line p-2.5 text-center text-[11px] text-ink-faint">Powered by Minecraft Server Manager.</p>
  </div>
  {{! A public status page that renders once goes stale in minutes - a plain
      meta refresh keeps it honest with zero JS on an anonymous page. }}
  <meta http-equiv="refresh" content="60">
{{/if}}
