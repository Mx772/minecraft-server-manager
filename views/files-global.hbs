{{> page-header heading="FILE MANAGER" sub="The whole panel data folder: servers, backups, library, and logs. Admins only, and the panel's own database is protected."}}

<div data-files-global data-files-path="{{filePath}}" class="contents">
  <div class="card">
    <div class="flex flex-wrap items-center gap-2 border-b border-line p-3">
      <nav class="flex min-w-0 flex-wrap items-center gap-1 font-mono text-sm text-ink-soft" aria-label="Breadcrumb">
        {{#if crumbs.length}}
          <a class="hover:text-link" href="/files">data</a>
          {{#each crumbs}}
            <span class="text-ink-faint">/</span>
            {{#if @last}}
              <span class="truncate text-ink">{{name}}</span>
            {{else}}
              <a class="hover:text-link" href="/files?path={{enc}}">{{name}}</a>
            {{/if}}
          {{/each}}
        {{else}}
          <span class="text-ink">data</span>
        {{/if}}
      </nav>
      <div class="sm:ml-auto flex flex-col sm:flex-row sm:flex-wrap gap-2">
        <button class="btn btn-sm" id="files-search" data-tip="Search the text of files under this folder.">{{{icon 'search' 'size-3.5'}}} Find in Files</button>
        <button class="btn btn-sm" id="files-upload">{{{icon 'upload' 'size-3.5'}}} Upload</button>
        <button class="btn btn-sm" id="files-mkdir">{{{icon 'folder-plus' 'size-3.5'}}} New Folder</button>
      </div>
    </div>
    {{> files-bulk-bar}}
    <div class="overflow-x-auto">
      <table class="table-base table-stack" id="files-table">
        <thead><tr><th class="w-10"><label class="msm-select-cell"><input type="checkbox" class="msm-check" id="files-select-all" aria-label="Select all"></label></th><th>Name</th><th class="text-right">Size</th><th class="text-right">Modified</th><th class="text-right">Actions</th></tr></thead>
        <tbody>
          {{#if filePath}}
            <tr>
              <td data-th="" colspan="5">
                <a class="flex items-center gap-2 text-ink-faint hover:text-link" href="/files{{#if parentEnc}}?path={{parentEnc}}{{/if}}">{{{icon 'corner-left-up' 'size-4'}}} ..</a>
              </td>
            </tr>
          {{/if}}
          {{#each files}}
            <tr data-file-row data-path="{{path}}" data-name="{{name}}" data-dir="{{dir}}" data-size="{{size}}" class="relative">
              {{! Stacked card (below sm): the checkbox pins to the card's top-right
                  corner instead of becoming its own "label: value" line. }}
              <td data-th="" class="absolute right-1 top-1 p-0 sm:static sm:px-4 sm:py-2.5"><label class="msm-select-cell"><input type="checkbox" class="msm-check" data-file-select aria-label="Select {{name}}"></label></td>
              {{! w-full + max-w-0 (sm+ only): makes `truncate` actually engage in an
                  auto-layout table - long names no longer force horizontal scroll. }}
              <td data-th="" class="pr-10 sm:w-full sm:max-w-0 sm:pr-4">
                <div class="flex items-center gap-2">
                  {{#if dir}}
                    {{{icon 'folder' 'size-4 shrink-0 text-warn'}}}
                    <a class="min-w-0 truncate font-medium hover:text-link" href="/files?path={{enc}}" title="{{name}}">{{name}}</a>
                  {{else}}
                    {{{icon 'file-text' 'size-4 shrink-0 text-ink-faint'}}}
                    <span class="min-w-0 truncate font-medium" title="{{name}}">{{name}}</span>
                  {{/if}}
                </div>
              </td>
              <td data-th="Size" class="whitespace-nowrap text-right text-ink-faint">{{bytes size}}</td>
              <td data-th="Modified" class="whitespace-nowrap text-right text-ink-faint" data-ts="{{mtime}}">{{mtime}}</td>
              <td data-th="" class="text-right"><div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
                {{#unless dir}}
                  <button class="btn btn-ghost btn-sm" data-file-edit data-tip="Edit as text (≤ 8 MB).">{{{icon 'file-code' 'size-3.5'}}}</button>
                  <button class="btn btn-ghost btn-sm" data-file-download data-tip="Download the file.">{{{icon 'download' 'size-3.5'}}}</button>
                {{/unless}}
                <button class="btn btn-ghost btn-sm" data-menu="file-menu-{{@index}}" data-tip="Rename, move, or copy this file.">{{{icon 'ellipsis' 'size-3.5'}}}</button>
                <template id="file-menu-{{@index}}">
                  <button data-file-rename data-path="{{path}}" data-name="{{name}}">{{{icon 'pencil' 'size-3.5'}}} Rename</button>
                  <button data-file-move data-path="{{path}}" data-name="{{name}}">{{{icon 'move' 'size-3.5'}}} Move to…</button>
                  <button data-file-copy data-path="{{path}}" data-name="{{name}}">{{{icon 'copy' 'size-3.5'}}} Copy to…</button>
                </template>
                <button class="btn btn-ghost btn-sm text-danger" data-file-delete data-tip="Delete this file ({{bytes size}})." aria-label="Delete {{name}}">{{{icon 'trash-2' 'size-3.5'}}}</button>
              </div></td>
            </tr>
          {{else}}
            <tr data-files-empty><td data-th="" colspan="5" class="py-10 text-center text-sm text-ink-faint">
              {{{icon 'folder-open' 'mx-auto size-6'}}}
              <p class="mt-2">This folder is empty. Upload files or create a folder above.</p>
            </td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  <p class="help mt-2 max-w-prose">Be careful: this is the panel's entire data folder. Deleting server or backup files here skips the usual safeguards.</p>
</div>
<script type="module" src="/js/pages/files-global.js"></script>
